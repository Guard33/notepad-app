PORT=5000
MONGODB_URI=your-mongodb-atlas-connection-string
JWT_SECRET=replace-with-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
# Comma-separated emails that get the admin role when they sign up or log in.
ADMIN_EMAILS=you@example.com
# On an empty database the server seeds the catalog plus ~30 sample orders
# (flagged "sample") so the admin dashboard has history. Set false to skip them.
SEED_SAMPLE_ORDERS=true
